@model EnrollmentPage
@{
    ViewData["Title"] = "Enrollments";
}
<p class="eyebrow">Progress / Enrollments</p>
<div class="heading"><h1>Enrollments</h1><a class="button" asp-action="Create">New enrollment</a></div>
<p class="muted">@Model.TotalCount records · Page @Model.Page · 50 per page. Write operations require Registrar access in the Enrollments service.</p>
@if (Model.Items.Length == 0)
{
    <p class="panel" role="status">No enrollments on this page.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <caption>Enrollment records</caption>
            <thead><tr><th scope="col">ID</th><th scope="col">Student</th><th scope="col">Course</th><th scope="col">Grade</th><th scope="col">Actions</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr><th scope="row">@item.Id</th><td><a asp-controller="Students" asp-action="Index" asp-route-id="@item.StudentId">@item.StudentId</a></td><td><a asp-controller="Catalog" asp-action="Details" asp-route-id="@item.CourseId">@item.CourseId</a></td><td>@(item.Grade ?? "Ungraded")</td><td><a asp-action="Edit" asp-route-id="@item.Id" aria-label="Edit enrollment @item.Id">Edit</a> · <a asp-action="Delete" asp-route-id="@item.Id" aria-label="Delete enrollment @item.Id">Delete</a></td></tr>
                }
            </tbody>
        </table>
    </div>
}
<nav class="pagination" aria-label="Enrollment pages">
    @if (Model.Page > 1)
    {
        <a asp-action="Index" asp-route-page="@(Model.Page - 1)">← Previous</a>
    }
    @if ((long)Model.Page * Model.PageSize < Model.TotalCount && Model.Page < 100000)
    {
        <a asp-action="Index" asp-route-page="@(Model.Page + 1)">Next →</a>
    }
</nav>
