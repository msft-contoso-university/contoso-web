@model ErrorView
@{
    ViewData["Title"] = Model.Title;
}
<section class="panel notice" role="alert">
    <p class="eyebrow">Request status</p>
    <h1>@Model.Title</h1>
    <p>@Model.Message</p>
    <p class="muted">Support reference: <code>@Model.TraceId</code></p>
    <a asp-controller="Home" asp-action="Index">Return home</a>
</section>
