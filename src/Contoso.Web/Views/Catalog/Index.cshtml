@model CoursePage
@{
    ViewData["Title"] = "Course catalog";
}
<p class="eyebrow">Learning / Catalog</p>
<h1>Discover your next course</h1>
<p class="muted">@Model.Count courses · Page @Model.CurrentPage of @Math.Max(1, Model.Pages)</p>
@if (Model.Courses.Length == 0)
{
    <p class="panel" role="status">No courses on this page.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <caption>Course catalog</caption>
            <thead><tr><th scope="col">Course</th><th scope="col">Department</th><th scope="col">Credits</th></tr></thead>
            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr><th scope="row"><a asp-action="Details" asp-route-id="@course.Id">@course.Title</a><small>ID @course.Id</small></th><td>@course.Department.Name</td><td>@course.Credits</td></tr>
                }
            </tbody>
        </table>
    </div>
}
<nav class="pagination" aria-label="Catalog pages">
    @if (Model.CurrentPage > 1)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">← Previous</a>
    }
    @if (Model.CurrentPage < Model.Pages && Model.CurrentPage < 100000)
    {
        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Next →</a>
    }
</nav>
